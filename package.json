{
  "name": "lumilearn-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "docker:start": "bash scripts/start.sh",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts && tsx scripts/seed-coppell.ts",
    "db:seed:practice": "tsx scripts/seed-coppell.ts",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "db:upgrade:lessons": "tsx scripts/upgrade-lessons.ts",
    "assets:pokemon": "node scripts/download-pokemon-assets.mjs",
    "prebuild": "npm run assets:pokemon"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-tabs": "1.1.13",
    "jose": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.12",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "27.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}

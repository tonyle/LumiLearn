POSTGRES_USER=lumilearn
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=lumilearn
DATABASE_URL=postgresql://lumilearn:change-this-local-database-password@db:5432/lumilearn
APP_URL=http://localhost:3000
# Optional override for direct docker compose use; npm run docker:start detects the host IP automatically
IPAD_APP_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-separate-32-byte-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_VOCAB_IMAGE_MODEL=gpt-image-2.5-flare
AI_ENABLED=false
AI_MONTHLY_BUDGET_USD=10
EXTERNAL_AI_OPT_IN=false
TZ=America/Chicago
UPLOAD_MAX_MB=20
LOG_LEVEL=info
COOKIE_SECURE=false
